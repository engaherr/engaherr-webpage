---
import { content } from '../data/content';
import SectionHeading from './SectionHeading.astro';

const copy = content.es;
---

<section class="border-b border-pale-stale/15 py-24 sm:py-32 lg:py-48 print:block print:border-0 print:bg-white print:py-0" id="cv">
	<div class="mx-auto w-[calc(100%-30px)] max-w-[1240px] sm:w-[calc(100%-36px)] lg:grid lg:w-[calc(100%-48px)] lg:grid-cols-[minmax(220px,0.68fr)_minmax(0,1.32fr)] lg:gap-[8vw] print:block print:w-full">
		<div class="print:hidden">
			<SectionHeading
				eyebrow={copy.resume.eyebrow}
				title={copy.resume.title}
				intro={copy.resume.description}
				section="resume"
				index="06"
			/>
		</div>

		<div class="mt-12 min-w-0 lg:mt-0 print:mt-0">
			<div class="mb-3 flex flex-col items-start justify-between gap-4 border border-pale-stale/15 bg-pale-stale/[0.02] p-3.5 sm:flex-row sm:items-center print:hidden">
				<span class="font-mono text-[9px] uppercase tracking-[0.1em] text-pale-stale/75" data-i18n="resume.documentLabel">{copy.resume.documentLabel}</span>
				<button class="inline-flex min-h-10 items-center justify-center gap-4 border border-pale-stale/35 bg-transparent px-3 py-2 font-mono text-[9px] uppercase tracking-[0.04em] text-pale-stale transition-colors duration-200 hover:border-yale-blue hover:text-pale-stale focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-pale-stale" type="button" data-print>
					<span data-i18n="resume.print">{copy.resume.print}</span>
					<span aria-hidden="true">↗</span>
				</button>
			</div>

			<article class="border border-pale-stale/35 bg-pale-stale p-6 text-evergreen sm:p-10 lg:p-14 print:block print:border-0 print:bg-white print:p-0" data-print-document>
				<header class="flex flex-col gap-6 border-b-2 border-evergreen pb-7 sm:flex-row sm:items-start sm:justify-between">
					<div>
						<span class="font-mono text-[9px] uppercase tracking-[0.12em] text-dark-spruce">ENRIQUE / 2026</span>
						<h3 class="mt-3 font-display text-[2.8rem] font-medium leading-[0.92] tracking-[-0.09em] sm:text-[clamp(2rem,4vw,4.4rem)]">Enrique Gamboa Hernández</h3>
						<p class="mt-2.5 text-sm text-evergreen/70" data-i18n="hero.eyebrow">{copy.hero.eyebrow}</p>
					</div>
					<div class="grid justify-items-start gap-1 font-mono text-[9px] leading-[1.45] text-evergreen/70 sm:justify-items-end sm:text-right">
						<a class="hover:text-dark-spruce hover:underline" href="mailto:egamboa020903@gmail.com">egamboa020903@gmail.com</a>
						<a class="hover:text-dark-spruce hover:underline" href="https://www.linkedin.com/in/enrique-gamboa-hernandez/" target="_blank" rel="noreferrer">linkedin.com/in/enrique-gamboa-hernandez</a>
						<a class="hover:text-dark-spruce hover:underline" href="https://github.com/engaherr" target="_blank" rel="noreferrer">github.com/engaherr</a>
						<span data-i18n="hero.location">{copy.hero.location}</span>
					</div>
				</header>

				<section class="border-b border-evergreen/20 py-7">
					<h4 class="mb-4 font-mono text-[9px] uppercase tracking-[0.1em] text-dark-spruce" data-i18n="resume.profileLabel">{copy.resume.profileLabel}</h4>
					<p class="max-w-[720px] text-[13px] leading-5 text-evergreen/80" data-i18n="about.paragraph1">{copy.about.paragraph1}</p>
					<p class="mt-2 max-w-[720px] text-[13px] leading-5 text-evergreen/80" data-i18n="about.paragraph2">{copy.about.paragraph2}</p>
				</section>

				<section class="border-b border-evergreen/20 py-7">
					<h4 class="mb-4 font-mono text-[9px] uppercase tracking-[0.1em] text-dark-spruce" data-i18n="resume.experienceLabel">{copy.resume.experienceLabel}</h4>
					{copy.experience.items.map((item, index) => (
						<div class="break-inside-avoid [&+div]:mt-5 [&+div]:border-t [&+div]:border-evergreen/15 [&+div]:pt-5">
							<div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
								<h5 class="text-[17px] font-bold tracking-[-0.035em]" data-i18n={`experience.items.${index}.role`}>{item.role}</h5>
								<time class="font-mono text-[9px] text-evergreen/60" data-i18n={`experience.items.${index}.period`}>{item.period}</time>
							</div>
							<p class="mt-0.5 font-mono text-[10px] text-dark-spruce" data-i18n={`experience.items.${index}.company`}>{item.company}</p>
							<ul class="mt-2 grid gap-1.5 list-disc pl-4 text-[11px] leading-4.5 text-evergreen/80">
								{item.bullets.slice(0, index === 0 ? 4 : 3).map((bullet, bulletIndex) => (
									<li data-i18n={`experience.items.${index}.bullets.${bulletIndex}`}>{bullet}</li>
								))}
							</ul>
						</div>
					))}
				</section>

				<section class="border-b border-evergreen/20 py-7">
					<h4 class="mb-4 font-mono text-[9px] uppercase tracking-[0.1em] text-dark-spruce" data-i18n="resume.projectsLabel">{copy.resume.projectsLabel}</h4>
					{copy.projects.items.map((project, index) => (
						<div class="break-inside-avoid [&+div]:mt-5 [&+div]:border-t [&+div]:border-evergreen/15 [&+div]:pt-5">
							<div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
								<h5 class="text-[17px] font-bold tracking-[-0.035em]" data-i18n={`projects.items.${index}.title`}>{project.title}</h5>
								<time class="font-mono text-[9px] text-evergreen/60" data-i18n={`projects.items.${index}.period`}>{project.period}</time>
							</div>
							<p class="mt-2 max-w-[760px] text-[11px] leading-4 text-evergreen/80" data-i18n={`projects.items.${index}.description`}>{project.description}</p>
						</div>
					))}
				</section>

				<section class="grid gap-7 py-7 sm:grid-cols-[1fr_0.8fr]">
					<div>
						<h4 class="mb-4 font-mono text-[9px] uppercase tracking-[0.1em] text-dark-spruce" data-i18n="resume.skillsLabel">{copy.resume.skillsLabel}</h4>
						<div class="grid gap-2 text-[11px] leading-4 text-evergreen/80">
							{copy.stack.groups.map((group, index) => (
								<p><strong class="text-evergreen" data-i18n={`stack.groups.${index}.title`}>{group.title}</strong> {group.items.join(' / ')}</p>
							))}
						</div>
					</div>
					<div>
						<h4 class="mb-4 font-mono text-[9px] uppercase tracking-[0.1em] text-dark-spruce" data-i18n="resume.educationLabel">{copy.resume.educationLabel}</h4>
						<div class="grid gap-1.5 text-[11px] leading-4 text-evergreen/80">
							<strong class="text-[13px] text-evergreen" data-i18n="education.degree">{copy.education.degree}</strong>
							<span data-i18n="education.school">{copy.education.school}</span>
							<span data-i18n="education.period">{copy.education.period}</span>
							<span data-i18n="education.gpa">{copy.education.gpa}</span>
							<span data-i18n="education.courses">{copy.education.courses}</span>
							<span data-i18n="education.research">{copy.education.research}</span>
							<span data-i18n="education.english">{copy.education.english}</span>
						</div>
					</div>
				</section>
			</article>
		</div>
	</div>
</section>
