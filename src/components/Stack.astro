---
import { content } from '../data/content';
import SectionHeading from './SectionHeading.astro';

const copy = content.es;
const animationDelays = ['animate-delay-0', 'animate-delay-100', 'animate-delay-200', 'animate-delay-300'];
---

<section class="border-b border-pale-stale/15 py-24 sm:py-32 lg:py-48 print:hidden" id="stack">
	<div class="mx-auto w-[calc(100%-30px)] max-w-[1240px] sm:w-[calc(100%-36px)] lg:grid lg:w-[calc(100%-48px)] lg:grid-cols-[minmax(220px,0.68fr)_minmax(0,1.32fr)] lg:gap-[8vw]">
		<SectionHeading
			eyebrow={copy.stack.eyebrow}
			title={copy.stack.title}
			intro={copy.stack.intro}
			section="stack"
			index="04"
		/>

		<div class="mt-12 grid gap-3 sm:grid-cols-2 lg:mt-0">
			{copy.stack.groups.map((group, index) => (
				<article class={`min-h-0 border border-pale-stale/15 bg-pale-stale/[0.02] p-5 transition-colors duration-200 hover:border-yale-blue/60 hover:bg-yale-blue/[0.06] motion-safe:animate-fade-in-up motion-safe:animate-duration-slow ${animationDelays[index]} sm:min-h-[286px] sm:p-6`}>
					<div class="font-mono text-[9px] uppercase tracking-[0.12em] text-pale-stale">0{index + 1}</div>
					<h3 class="mt-11 font-display text-[26px] font-medium tracking-[-0.06em] text-pale-stale sm:mt-16" data-i18n={`stack.groups.${index}.title`}>{group.title}</h3>
					<p class="mt-2.5 max-w-[260px] text-[13px] text-pale-stale/75" data-i18n={`stack.groups.${index}.description`}>{group.description}</p>
					<div class="mt-5 flex flex-wrap gap-1.5">
						{group.items.map((item) => <span class="inline-flex min-h-6 items-center border border-pale-stale/20 px-2 py-1 font-mono text-[9px] tracking-[0.04em] text-pale-stale/75">{item}</span>)}
					</div>
				</article>
			))}
		</div>

		<div class="mt-12 flex items-center gap-3 font-mono text-[8px] uppercase tracking-[0.1em] text-pale-stale/75 sm:col-span-2 sm:mt-14 sm:text-[9px] lg:col-span-2">
			<span class="h-px flex-1 bg-pale-stale/15"></span>
			<span>TOOLS / METHODS / CURIOSITY</span>
			<span class="h-px flex-1 bg-pale-stale/15"></span>
		</div>
	</div>
</section>
