---
import { content } from '../data/content';
import SectionHeading from './SectionHeading.astro';

const copy = content.es;
---

<section class="border-b border-pale-stale/15 py-24 sm:py-32 lg:py-48 print:hidden" id="education">
	<div class="mx-auto w-[calc(100%-30px)] max-w-[1240px] sm:w-[calc(100%-36px)] lg:grid lg:w-[calc(100%-48px)] lg:grid-cols-[minmax(220px,0.68fr)_minmax(0,1.32fr)] lg:gap-[8vw]">
		<SectionHeading
			eyebrow={copy.education.eyebrow}
			title={copy.education.title}
			section="education"
			index="05"
		/>

		<div class="mt-12 grid gap-3 sm:grid-cols-[1.15fr_0.85fr] lg:mt-0">
			<article class="min-h-[240px] border border-pale-stale/15 bg-dark-spruce p-5 sm:min-h-[280px] sm:p-6">
				<div class="flex items-center justify-between gap-4 font-mono text-[9px] uppercase tracking-[0.12em] text-pale-stale/75">
					<span class="text-pale-stale">EDU_01</span>
					<time datetime="2026-01" data-i18n="education.period">{copy.education.period}</time>
				</div>
				<h3 class="mt-14 max-w-[400px] font-display text-[2rem] font-medium leading-[0.95] tracking-[-0.075em] text-pale-stale sm:mt-[74px] sm:text-[clamp(1.8rem,3vw,3.1rem)]" data-i18n="education.degree">{copy.education.degree}</h3>
				<p class="mt-3 text-sm text-pale-stale" data-i18n="education.school">{copy.education.school}</p>
				<div class="mt-10 flex flex-wrap justify-between gap-2.5 font-mono text-[10px] text-pale-stale/75">
					<span data-i18n="education.location">{copy.education.location}</span>
					<span data-i18n="education.gpa">{copy.education.gpa}</span>
				</div>
				<div class="mt-6 grid gap-2 border-t border-pale-stale/15 pt-5 text-[11px] leading-5 text-pale-stale/75">
					<p data-i18n="education.courses">{copy.education.courses}</p>
					<p data-i18n="education.research">{copy.education.research}</p>
				</div>
			</article>

			<article class="flex min-h-[240px] items-end justify-between gap-5 border border-pale-stale/15 bg-gradient-to-br from-oxford-navy/70 to-dark-spruce p-5 sm:min-h-[280px] sm:p-6">
				<div>
					<span class="font-mono text-[9px] uppercase tracking-[0.12em] text-pale-stale">LANG_01</span>
					<h3 class="mt-5 font-display text-[25px] font-medium tracking-[-0.06em] text-pale-stale" data-i18n="education.english">{copy.education.english}</h3>
					<p class="mt-1 font-mono text-[10px] uppercase text-pale-stale/75" data-i18n="education.englishDetail">{copy.education.englishDetail}</p>
				</div>
				<div class="grid size-[92px] shrink-0 place-items-center rounded-full border border-yale-blue text-2xl font-semibold tracking-[-0.1em] text-pale-stale shadow-[0_0_0_12px_rgba(0,83,119,0.12)] sm:size-[104px]" aria-hidden="true">B2</div>
			</article>
		</div>
	</div>
</section>
